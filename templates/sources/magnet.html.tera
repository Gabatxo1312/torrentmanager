						<div class="column is-one-third box" style="border: solid 1px black;">
							<h2 class="title" style="text-align: center;"><label for="magnet">MAGNET</label></h2>
							<div class="columns is-vcentered is-centered">
								<div class="column is-one-quarter">
									<img src="/assets/images/magnet.png" class="image is-64x64">
								</div>
								<div class="column is-half">
									<input type="text" name="magnet" id="magnet"{% if post.magnet %} value="{{ post.magnet }}"{% endif %}>
								</div>
							</div>
						</div>
