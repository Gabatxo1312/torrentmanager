{% extends "base" %}

{% block title %}Où sauvegarder ?{% endblock %}
{% block main %}
                    <h1 class="title" style="text-align: center;">Torrent Importer (Upload)</h2>
                    <div class="buttons is-centered">
                    </div>

		            <form method="POST" action="/upload/step2" accept-charset="utf-8">
                        <h1 class="title" style="text-align: center;">
                            Où sauvegarder?
                        </h1>
                        <input type="hidden" name="collection" value="{{ collection }}">
                        <input type="hidden" name="content" value="{{ content }}">
                        <div class="box" style="margin: 1rem auto; text-align: center; max-width: 512px;">
                            <div class="select is-centered">
                                <select name="basedir">
                                    <option value=".">CE DOSSIER</option>
{% for folder in folders|default(value=[]) %}
                                    <option value="{{ folder }}">{{ folder }}</option>
{% endfor %}
                                </select>
                            </div>
                            <br><br>
                            <h2>Nommer le futur dossier:</h2>
                            <input type="text" name="targetdir" value=".">
                            <p>Si rien n'est mis, le nom sera automatiquement extrait du torrent</p>
                        </div>

                        <div class="buttons is-centered control">
                            <a href="index.php" class="button is-info">Back</a>
                            <input type="Submit" class="button is-success" value="Next">
                        </div>
		            </form>
{% endblock %}
